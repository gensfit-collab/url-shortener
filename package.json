{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "A containerized URL Shortener application built with modern DevOps practices, CI/CD, and AWS deployment.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --setupFilesAfterEnv=./tests/jest.setup.js",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gensfit-collab/url-shortener.git"
  },
  "keywords": [
    "url-shortener",
    "nodejs",
    "express",
    "rest-api",
    "devops"
  ],
  "author": "Genesis P.",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gensfit-collab/url-shortener/issues"
  },
  "homepage": "https://github.com/gensfit-collab/url-shortener#readme",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.14",
    "dotenv": "^18.0.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.6.2",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "prisma": "^8.0.0-rc.20",
    "supertest": "^7.3.1"
  }
}
