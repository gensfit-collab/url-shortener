{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "A containerized URL Shortener application built with modern DevOps practices, CI/CD, and AWS deployment.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --setupFilesAfterEnv=./tests/jest.setup.js",
    "postinstall": "prisma generate || exit 0",
    "lint": "eslint .",
    "build": "node -e \"require('./src/app'); console.log('Application build validation passed')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gensfit-collab/url-shortener.git"
  },
  "keywords": [
    "url-shortener",
    "nodejs",
    "express",
    "rest-api",
    "devops"
  ],
  "author": "Genesis P.",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gensfit-collab/url-shortener/issues"
  },
  "homepage": "https://github.com/gensfit-collab/url-shortener#readme",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "dotenv": "18.0.5",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.11.30",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prisma": "^5.19.0",
    "supertest": "7.3.1"
  }
}
