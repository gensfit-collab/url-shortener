    "id": "table.Url",
    "label": "Create table \"Url\"",
    "summary": "Creates table \"Url\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Url"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Url\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Url\""
        ]
