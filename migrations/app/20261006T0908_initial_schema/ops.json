    ],
    "execute": [
      {
        "description": "create table \"Url\"",
        "sql": "CREATE TABLE \"public\".\"Url\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"originalUrl\" text NOT NULL,\n  \"shortCode\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Url\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Url\""
        ]
      }
    ]
  },
  {
    "id": "unique.Url.Url_shortCode_key",
    "label": "Add unique constraint on \"Url\" (shortCode)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Url_shortCode_key",
        "table": "Url"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Url_shortCode_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Url_shortCode_key",
          "public",
          "\"public\".\"Url\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Url_shortCode_key\"",
        "sql": "ALTER TABLE \"public\".\"Url\" ADD CONSTRAINT \"Url_shortCode_key\" UNIQUE (\"shortCode\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"Url_shortCode_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Url_shortCode_key",
          "public",
          "\"public\".\"Url\""
        ]
      }
    ]
  }
